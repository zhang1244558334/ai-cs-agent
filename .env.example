# LLM
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=ai_cs_agent_knowledge

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/chat.db

# Platform
BOT_PLATFORM=web

# Handover
HANDOVER_KEYWORDS=人工,转人工,客服,真人,投诉
HANDOVER_TIMEOUT=3600

# Logging
LOG_LEVEL=INFO
